# ── Database (Neon PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/learnai?sslmode=require

# ── AI Keys ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@learn-ai.com
APP_URL=https://learn-ai.com

# ── Storage (Cloudflare R2) ───────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=learnai-storage
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── GCP Video Rendering (reuse AnimLearn Cloud Run) ───────
CLOUD_RUN_VIDEO_URL=https://your-cloud-run-service.run.app/render
CLOUD_RUN_SECRET=your-cloud-run-secret

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_LEARNER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
