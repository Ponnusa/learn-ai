{
  "manifest_version": 3,
  "name": "LearnX Genie",
  "version": "0.1.0",
  "description": "Select text on any page and ask LearnX to explain it, walk you through it, or quiz you on it.",
  "key": "",
  "action": {
    "default_title": "Ask LearnX"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": ["activeTab", "storage", "sidePanel", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
