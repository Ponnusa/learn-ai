# General
.DS_Store
*.log

# Worker script (contains hardcoded secrets — keep local only)
worker.py

# Local planning docs — not for version control
SPRINT_*.md
*.plan.md

# Pixel AI (Raspberry Pi companion robot client)
pixel-ai/pixel_env/
pixel-ai/**/__pycache__/
pixel-ai/*.pyc
pixel-ai/.env
# Personal data about a specific student -- never committed.
# persona/IDENTITY.md (Pixel's own generic personality) stays tracked.
pixel-ai/persona/MEMORY.md
# Opt-in debug recordings of the student's actual voice (PIXEL_AUDIO_LOG_DIR) -- never committed.
pixel-ai/audio_log/
# Raw per-session transcripts, saved before summarization -- personal data, never committed.
pixel-ai/persona/transcripts/
# Pixel's current name if renamed locally -- a live customization, not generic shared identity.
pixel-ai/persona/NAME.txt
# Per-question routing log (which tier answered each question) -- real conversation content, never committed.
pixel-ai/persona/routing_log.jsonl
# Second-screen preview image (pixel_screen2.py's stand-in for real display hardware) -- regenerated each call, never committed.
pixel-ai/persona/screen2_preview.png

# Chitti (child-safe companion robot)
chitti/.venv/
chitti/**/__pycache__/
chitti/*.pyc
chitti/.env
chitti/chitti_env/
chitti/.pytest_cache/
chitti/src/*.egg-info/
# Real local SQLite DB + session secret key for the Parent Controls
# web UI (scripts/run_parent_controls.sh) -- contains the parent's own
# PIN hash and real profile/story data, never committed.
chitti/data/

# Story Stage (narration -> LLM scene JSON -> pygame renderer prototype)
story_stage/.venv/
story_stage/**/__pycache__/
story_stage/*.pyc
story_stage/.env
story_stage/.pytest_cache/
story_stage/src/*.egg-info/
