# Chitti environment configuration.
# Copy this file to .env (gitignored, never committed) and fill in real
# values. Loaded automatically by companion_robot/config/loader.py.

# Required by voice/openai_backend.py's OpenAILanguageModelBackend.
OPENAI_API_KEY=

# Required by voice/claude_backend.py's ClaudeLanguageModelBackend.
ANTHROPIC_API_KEY=

# Optional, used by audio/real.py + voice_loop_demo.py. ALSA's
# "default" device often doesn't route to the actual USB mic/speaker
# on real hardware -- same real-world lesson pixel-ai's own
# PIXEL_MIC_DEVICE/PIXEL_SPEAKER_DEVICE already document. Run
# `arecord -l` / `aplay -l` to find the right card/device (e.g.
# "plughw:1,0") if recording or playback silently does nothing.
#CHITTI_MIC_DEVICE=default
#CHITTI_SPEAKER_DEVICE=default
