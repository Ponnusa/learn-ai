LEARNX_API_URL=https://learn-ai-production.up.railway.app
LEARNX_API_KEY=lx_live_your_key_here
LEARNX_USER_ID=your-developer-account-user-id
PIXEL_LANGUAGE=en

# Used by pixel_gemini.py / pixel_gemini_text.py / pixel_gemini_voice.py
# only — independent of everything above, LearnX is paused for these.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_TEXT_MODEL=gemini-3.8-flash
PIXEL_MIC_DEVICE=default
# pixel_gemini_voice.py's local silence-detection tuning. Watch its
# "ambient level: current=X peak=Y" log line for real numbers from your
# actual mic/room before picking a START_RMS value -- 300 was too
# sensitive and triggered on background noise on a webcam mic.
PIXEL_VAD_START_RMS=600
PIXEL_VAD_SILENCE_MS=800
PIXEL_VAD_MIN_MS=600

# Used by pixel_openai_voice.py / pixel_openai_voice_semantic.py --
# a separate provider/key from everything above, also independent of LearnX.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-realtime
# pixel_openai_voice_semantic.py only. "high" is the only eagerness level
# confirmed (via live multi-turn testing) to complete turns reliably --
# "low"/"medium" showed real problems (stuck forever, or a flaky empty
# turn), not just slowness. Don't change without re-verifying the same way.
PIXEL_SEMANTIC_VAD_EAGERNESS=high
# Debugging aid, opt-in: set to save every sent utterance (WAV) plus a
# JSONL log pairing it with the reply, so you can listen back and check
# for overlap/merged-utterance issues. Unset = disabled (default) --
# leave it off in normal use, these are real voice recordings and the
# SD card is small.
#PIXEL_AUDIO_LOG_DIR=./audio_log
